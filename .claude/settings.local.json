{
  "permissions": {
    "additionalDirectories": [
      "..\\vscode"
    ],
    "allow": [
      "Bash(mkdir -p /tmp/tmtrace)",
      "Read(//tmp/**)",
      "Bash(rm -rf *)",
      "Bash(unzip -o -q /d/git_project/universe-editor.worktrees/task1/apps/editor/e2e/test-results/smoke.textMate--p0-textmat-99ebe-follow-color-theme-switches-repeat9/trace.zip)",
      "Bash(ls)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | grep -E '\\.(ts|tsx|js|jsx)$' | grep -viE '[/\\\\]vendor[/\\\\]' | xargs -d '\\n' -r pnpm exec eslint --fix",
            "statusMessage": "ESLint fix..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/save-plan-result.cjs"
          }
        ]
      }
    ]
  }
}
