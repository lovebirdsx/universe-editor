{
  // 打包版内嵌的产品默认配置（对等 electron-builder.yml 的 publish.url 之于自动更新）。
  // 由 scripts/release/runtime-resources.mjs stage 进 resources/product.json，随
  // extraResources 内嵌进产物；main 在 app.isPackaged 时读取，作为配置解析链的
  // 最低优先级源。运行时仍可覆盖（不必重新打包）：
  //   --gallery-url=<url> / 环境变量 UNIVERSE_GALLERY_URL / <userData>/update-config.json 的 galleryUrl 字段。
  // 置空该字段即回到无市场（OSS 语义）。市场与更新可不同源，各自独立默认。
  "galleryUrl": "http://gallery.example.com:9999/universe-editor"

  // 另有一个 "configurationDefaults" 字段（settings.json 配置项的出厂默认值，
  // 优先级高于配置项自己的 schema default、低于用户 settings.json），刻意不在此
  // 声明占位值——一个指向 example.com 的假地址会让功能「看起来已配置」然后诡异
  // 失败，比未配置时的静默不可用更难排查。该字段只由 scripts/release/
  // runtime-resources.mjs 按 scripts/lib/productDefaults.mjs 的映射表从 .env 写入。
}
