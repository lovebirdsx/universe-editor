{
  "name": "@universe-editor/editor",
  "version": "0.13.6",
  "private": true,
  "description": "VSCode-style desktop game content editor.",
  "author": "Universe Editor Contributors",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:run": "node scripts/dev-run.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "node scripts/typecheck.mjs",
    "test:main": "vitest run --project main",
    "test:renderer-node": "vitest run --project renderer-node",
    "test:renderer-dom": "vitest run --project renderer-dom",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config integration/vitest.config.ts --reporter=verbose",
    "bench": "vitest bench --config bench/vitest.bench.config.ts",
    "test:visual": "cross-env PLAYWRIGHT_FORCE_TTY=0 UNIVERSE_E2E_ONLY_TAG=@visual playwright test -c e2e/playwright.config.ts",
    "visual:update": "cross-env PLAYWRIGHT_FORCE_TTY=0 UNIVERSE_E2E_ONLY_TAG=@visual playwright test -c e2e/playwright.config.ts --update-snapshots",
    "e2eg": "node ../../scripts/e2e/ensure-e2e-build.mjs @universe-editor/editor && cross-env PLAYWRIGHT_FORCE_TTY=0 UNIVERSE_E2E_NO_TAG_FILTER=1 playwright test -c e2e/playwright.config.ts --grep ",
    "e2e": "node ../../scripts/e2e/run-e2e.mjs --scope editor",
    "e2ea": "node ../../scripts/e2e/run-e2e.mjs --scope editor --suite e2ea",
    "e2e:smoke": "node ../../scripts/e2e/ensure-e2e-build.mjs @universe-editor/editor && cross-env PLAYWRIGHT_FORCE_TTY=0 UNIVERSE_E2E_ONLY_TAG=@p0 \"UNIVERSE_E2E_ONLY_TAG_INVERT=@serial|@flaky|@perf|@visual\" playwright test -c e2e/playwright.config.ts",
    "e2e:regression": "node ../../scripts/e2e/ensure-e2e-build.mjs @universe-editor/editor && cross-env PLAYWRIGHT_FORCE_TTY=0 UNIVERSE_E2E_ONLY_TAG=@regression playwright test -c e2e/playwright.config.ts",
    "e2e:headed": "node ../../scripts/e2e/ensure-e2e-build.mjs @universe-editor/editor && cross-env UNIVERSE_E2E_SHOW=1 playwright test -c e2e/playwright.config.ts --headed",
    "e2e:ui": "node ../../scripts/e2e/ensure-e2e-build.mjs @universe-editor/editor && cross-env UNIVERSE_E2E_SHOW=1 playwright test -c e2e/playwright.config.ts --ui",
    "e2e:install": "playwright install-deps",
    "lint": "eslint src bench integration e2e --cache --cache-strategy content",
    "lint:fix": "eslint --fix src bench integration e2e",
    "clean": "tsgo --build --clean",
    "package": "pnpm run package:win",
    "package:win": "node ../../scripts/release/package-editor.mjs --win nsis dir",
    "package:win:dir": "node ../../scripts/release/package-editor.mjs --win dir",
    "package:win:installer": "node ../../scripts/release/package-editor.mjs --win nsis",
    "package:linux:dir": "node ../../scripts/release/package-editor.mjs --linux dir --publish never --verify-root apps/editor/release/linux-unpacked/resources"
  },
  "dependencies": {
    "@parcel/watcher": "catalog:",
    "@lydell/node-pty": "catalog:",
    "adm-zip": "catalog:",
    "electron-updater": "^6.3.0",
    "jsonc-parser": "catalog:",
    "@vscode/ripgrep": "catalog:",
    "@vscode/windows-process-tree": "catalog:",
    "tar": "catalog:",
    "smol-toml": "catalog:"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@floating-ui/react": "catalog:",
    "@fontsource/roboto": "catalog:",
    "@react-aria/focus": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@types/adm-zip": "catalog:",
    "@vscode/codicons": "catalog:",
    "@xterm/addon-fit": "catalog:",
    "@xterm/addon-web-links": "catalog:",
    "@xterm/xterm": "catalog:",
    "allotment": "catalog:",
    "lucide-react": "catalog:",
    "mermaid": "catalog:",
    "monaco-editor": "catalog:",
    "vscode-oniguruma": "catalog:",
    "vscode-textmate": "catalog:",
    "vscode-jsonrpc": "catalog:",
    "vscode-languageserver-protocol": "catalog:",
    "vscode-languageserver-types": "catalog:",
    "zod": "catalog:",
    "@playwright/test": "catalog:",
    "cross-env": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@universe-editor/config-eslint": "workspace:*",
    "@universe-editor/config-ts": "workspace:*",
    "@universe-editor/e2e-contract": "workspace:*",
    "@universe-editor/e2e-harness": "workspace:*",
    "@universe-editor/extension-api": "workspace:*",
    "@universe-editor/extension-gallery": "workspace:*",
    "@universe-editor/extension-host": "workspace:*",
    "@universe-editor/extension-packaging": "workspace:*",
    "@universe-editor/extensions-common": "workspace:*",
    "@universe-editor/git": "workspace:*",
    "@universe-editor/markdown": "workspace:*",
    "@universe-editor/node-services": "workspace:*",
    "@universe-editor/platform": "workspace:*",
    "@universe-editor/typescript": "workspace:*",
    "@universe-editor/workbench-ui": "workspace:*",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-react-oxc": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "material-icon-theme": "catalog:",
    "pixelmatch": "catalog:",
    "pngjs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "catalog:"
  }
}
