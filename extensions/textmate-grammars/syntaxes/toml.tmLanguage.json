{
	"information_for_contributors": [
		"Hand-written for Universe Editor (TOML is not part of VSCode's built-in grammars).",
		"Covers TOML v1.0: tables, key/value pairs, strings, numbers, booleans, dates, arrays and inline tables."
	],
	"name": "TOML",
	"scopeName": "source.toml",
	"fileTypes": [
		"toml"
	],
	"patterns": [
		{
			"include": "#comment"
		},
		{
			"include": "#table"
		},
		{
			"include": "#keyValue"
		}
	],
	"repository": {
		"comment": {
			"name": "comment.line.number-sign.toml",
			"match": "#.*$"
		},
		"table": {
			"name": "meta.section.header.toml",
			"begin": "^\\s*(\\[)(\\[)?",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.table.toml"
				},
				"2": {
					"name": "punctuation.definition.table.array.toml"
				}
			},
			"end": "(\\])(\\])?|(?=$)",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.table.toml"
				},
				"2": {
					"name": "punctuation.definition.table.array.toml"
				}
			},
			"patterns": [
				{
					"include": "#tableKey"
				}
			]
		},
		"tableKey": {
			"patterns": [
				{
					"name": "entity.name.section.table.toml",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"include": "#escape"
						}
					]
				},
				{
					"name": "entity.name.section.table.toml",
					"match": "'[^']*'"
				},
				{
					"name": "entity.name.section.table.toml",
					"match": "[A-Za-z0-9_-]+"
				},
				{
					"name": "punctuation.separator.dot.toml",
					"match": "\\."
				}
			]
		},
		"keyValue": {
			"begin": "((?:[A-Za-z0-9_-]+|\"(?:[^\"\\\\]|\\\\.)*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"(?:[^\"\\\\]|\\\\.)*\"|'[^']*'))*)\\s*(=)",
			"beginCaptures": {
				"1": {
					"name": "variable.other.key.toml"
				},
				"2": {
					"name": "keyword.operator.assignment.toml"
				}
			},
			"end": "(?=\\s*[,}#])|(?=\\s*$)",
			"patterns": [
				{
					"include": "#value"
				}
			]
		},
		"value": {
			"patterns": [
				{
					"include": "#stringBasicMultiline"
				},
				{
					"include": "#stringLiteralMultiline"
				},
				{
					"include": "#stringBasic"
				},
				{
					"include": "#stringLiteral"
				},
				{
					"include": "#dateTime"
				},
				{
					"include": "#boolean"
				},
				{
					"name": "constant.numeric.float.toml",
					"match": "[-+]?(?:inf|nan)\\b"
				},
				{
					"name": "constant.numeric.float.toml",
					"match": "[-+]?(?:\\d[\\d_]*\\.[\\d_]*(?:[eE][-+]?\\d[\\d_]*)?|\\d[\\d_]*[eE][-+]?\\d[\\d_]*)"
				},
				{
					"name": "constant.numeric.hex.toml",
					"match": "[-+]?0x[0-9A-Fa-f](?:[0-9A-Fa-f_]*[0-9A-Fa-f])?"
				},
				{
					"name": "constant.numeric.octal.toml",
					"match": "[-+]?0o[0-7](?:[0-7_]*[0-7])?"
				},
				{
					"name": "constant.numeric.binary.toml",
					"match": "[-+]?0b[01](?:[01_]*[01])?"
				},
				{
					"name": "constant.numeric.integer.toml",
					"match": "[-+]?\\d(?:[\\d_]*\\d)?"
				},
				{
					"include": "#array"
				},
				{
					"include": "#inlineTable"
				}
			]
		},
		"escape": {
			"patterns": [
				{
					"name": "constant.character.escape.toml",
					"match": "\\\\(?:[btnfr\"\\\\]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
				},
				{
					"name": "invalid.illegal.escape.toml",
					"match": "\\\\."
				}
			]
		},
		"stringBasic": {
			"name": "string.quoted.double.toml",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"include": "#escape"
				}
			]
		},
		"stringBasicMultiline": {
			"name": "string.quoted.double.toml",
			"begin": "\"\"\"",
			"end": "\"\"\"",
			"patterns": [
				{
					"include": "#escape"
				},
				{
					"name": "constant.character.escape.toml",
					"match": "\\\\$"
				}
			]
		},
		"stringLiteral": {
			"name": "string.quoted.single.toml",
			"match": "'[^']*'"
		},
		"stringLiteralMultiline": {
			"name": "string.quoted.single.toml",
			"begin": "'''",
			"end": "'''"
		},
		"dateTime": {
			"patterns": [
				{
					"name": "constant.numeric.datetime.offset.toml",
					"match": "\\d{4}-\\d{2}-\\d{2}[Tt ]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[-+]\\d{2}:\\d{2})"
				},
				{
					"name": "constant.numeric.datetime.local.toml",
					"match": "\\d{4}-\\d{2}-\\d{2}[Tt ]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?"
				},
				{
					"name": "constant.numeric.date.toml",
					"match": "\\d{4}-\\d{2}-\\d{2}"
				},
				{
					"name": "constant.numeric.time.toml",
					"match": "\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?"
				}
			]
		},
		"boolean": {
			"name": "constant.language.boolean.toml",
			"match": "\\b(?:true|false)\\b"
		},
		"array": {
			"name": "meta.structure.array.toml",
			"begin": "\\[",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.array.toml"
				}
			},
			"end": "\\]",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.array.toml"
				}
			},
			"patterns": [
				{
					"include": "#comment"
				},
				{
					"include": "#value"
				},
				{
					"name": "punctuation.separator.array.toml",
					"match": ","
				}
			]
		},
		"inlineTable": {
			"name": "meta.structure.table.inline.toml",
			"begin": "\\{",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.table.inline.toml"
				}
			},
			"end": "\\}",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.table.inline.toml"
				}
			},
			"patterns": [
				{
					"include": "#keyValue"
				},
				{
					"name": "punctuation.separator.table.inline.toml",
					"match": ","
				}
			]
		}
	}
}
