{
  "name": "@universe-editor/theme-defaults",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "themes",
    "icons"
  ],
  "displayName": "Universe Themes",
  "description": "Built-in default color themes (Universe Dark / Universe Light) and the default file icon theme.",
  "engines": {
    "universe": ">=0.1.0 <1.0.0"
  },
  "contributes": {
    "themes": [
      {
        "id": "Universe Dark",
        "label": "Universe Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/universe-dark.json"
      },
      {
        "id": "Universe Light",
        "label": "Universe Light",
        "uiTheme": "vs",
        "path": "./themes/universe-light.json"
      }
    ],
    "iconThemes": [
      {
        "id": "universe-material",
        "label": "Universe Material",
        "path": "./icons/universe-material-icon-theme.json"
      }
    ]
  }
}
