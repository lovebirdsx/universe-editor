{
  "name": "@universe-editor/typescript",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "icon.svg",
    "package.nls.json",
    "package.nls.zh-cn.json"
  ],
  "displayName": "TypeScript Language Features",
  "icon": "icon.svg",
  "description": "TS/JS language features (definition, references, hover, completion, signature help, document symbols, rename, diagnostics) backed by an in-process typescript-language-server.",
  "main": "dist/extension.js",
  "engines": {
    "universe": "^0.13.0"
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onCommand:typescript.restartTsServer",
    "onCommand:typescript.openTsServerLog"
  ],
  "contributes": {
    "commands": [
      {
        "command": "typescript.restartTsServer",
        "title": "%ts.command.restartTsServer.title%",
        "category": "TypeScript"
      },
      {
        "command": "typescript.openTsServerLog",
        "title": "%ts.command.openTsServerLog.title%",
        "category": "TypeScript"
      }
    ],
    "configuration": {
      "title": "TypeScript",
      "properties": {
        "js/ts.tsserver.log": {
          "type": "string",
          "enum": ["off", "terse", "normal", "verbose", "requestTime"],
          "enumDescriptions": [
            "%ts.config.tsserver.log.off.description%",
            "%ts.config.tsserver.log.terse.description%",
            "%ts.config.tsserver.log.normal.description%",
            "%ts.config.tsserver.log.verbose.description%",
            "%ts.config.tsserver.log.requestTime.description%"
          ],
          "default": "off",
          "description": "%ts.config.tsserver.log.description%"
        },
        "js/ts.referencesCodeLens.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%ts.config.referencesCodeLens.enabled.description%"
        },
        "js/ts.referencesCodeLens.showOnAllFunctions": {
          "type": "boolean",
          "default": false,
          "description": "%ts.config.referencesCodeLens.showOnAllFunctions.description%"
        },
        "js/ts.implementationsCodeLens.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%ts.config.implementationsCodeLens.enabled.description%"
        },
        "js/ts.implementationsCodeLens.showOnInterfaceMethods": {
          "type": "boolean",
          "default": false,
          "description": "%ts.config.implementationsCodeLens.showOnInterfaceMethods.description%"
        },
        "js/ts.implementationsCodeLens.showOnAllClassMethods": {
          "type": "boolean",
          "default": false,
          "description": "%ts.config.implementationsCodeLens.showOnAllClassMethods.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsgo --noEmit && tsgo --project e2e/tsconfig.json",
    "lint": "eslint src --cache --cache-strategy content",
    "lint:fix": "eslint --fix src",
    "test": "vitest run",
    "e2e": "node ../../scripts/e2e/ensure-e2e-build.mjs @universe-editor/typescript && cross-env PLAYWRIGHT_FORCE_TTY=0 playwright test -c e2e/playwright.config.ts",
    "e2ea": "node ../../scripts/e2e/ensure-e2e-build.mjs @universe-editor/typescript && cross-env PLAYWRIGHT_FORCE_TTY=0 UNIVERSE_E2E_INCLUDE_REGRESSION=1 playwright test -c e2e/playwright.config.ts",
    "e2eg": "node ../../scripts/e2e/ensure-e2e-build.mjs @universe-editor/typescript && cross-env PLAYWRIGHT_FORCE_TTY=0 UNIVERSE_E2E_NO_TAG_FILTER=1 playwright test -c e2e/playwright.config.ts --grep ",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "cross-env": "catalog:",
    "@universe-editor/config-ts": "workspace:*",
    "@universe-editor/e2e-harness": "workspace:*",
    "@universe-editor/extension-api": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vscode-jsonrpc": "catalog:",
    "vscode-languageserver-types": "catalog:",
    "vscode-uri": "catalog:"
  }
}
