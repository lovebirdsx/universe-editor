{
  "name": "@universe-editor/acp-view-model",
  "version": "0.0.0",
  "description": "Pure, DOM-free ACP presentation helpers (ANSI parsing, markdown rendering, file-path links, line diffs, content limits) shared by the editor renderer and the phone PWA. Internal package — zero runtime dependencies.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsgo --build",
    "typecheck": "tsgo --build",
    "test": "vitest run",
    "lint": "eslint src --cache --cache-strategy content",
    "lint:fix": "eslint --fix src",
    "dev": "tsgo --build --watch",
    "clean": "tsgo --build --clean"
  },
  "dependencies": {},
  "devDependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@universe-editor/config-ts": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
