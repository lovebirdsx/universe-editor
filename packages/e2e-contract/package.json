{
  "name": "@universe-editor/e2e-contract",
  "version": "0.1.0",
  "description": "Universe Editor E2E probe contract: the window.__E2E__ probe types and constants, shared by @universe-editor/e2e-harness and the editor.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovebirdsx/universe-editor.git",
    "directory": "packages/e2e-contract"
  },
  "homepage": "https://github.com/lovebirdsx/universe-editor#readme",
  "keywords": [
    "universe-editor",
    "e2e",
    "contract",
    "probe"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsgo --build",
    "typecheck": "tsgo --build",
    "lint": "eslint src --cache --cache-strategy content",
    "lint:fix": "eslint --fix src",
    "dev": "tsgo --build --watch",
    "clean": "tsgo --build --clean"
  },
  "devDependencies": {
    "@universe-editor/config-eslint": "workspace:*",
    "@universe-editor/config-ts": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
