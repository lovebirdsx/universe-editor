{
  "name": "@universe-editor/e2e-harness",
  "version": "0.1.0",
  "description": "Playwright fixtures, page objects, and launch helpers for running E2E tests against Universe Editor.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovebirdsx/universe-editor.git",
    "directory": "packages/e2e-harness"
  },
  "homepage": "https://github.com/lovebirdsx/universe-editor#readme",
  "keywords": [
    "universe-editor",
    "e2e",
    "playwright",
    "testing"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsgo --build",
    "typecheck": "tsgo --build",
    "lint": "eslint src --cache --cache-strategy content",
    "lint:fix": "eslint --fix src",
    "dev": "tsgo --build --watch",
    "clean": "tsgo --build --clean"
  },
  "dependencies": {
    "@universe-editor/e2e-contract": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": "^1.62.0"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@universe-editor/config-eslint": "workspace:*",
    "@universe-editor/config-ts": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
