{
  "name": "@universe-editor/extension-api",
  "version": "0.13.0",
  "description": "Extension API surface for Universe Editor (the Universe equivalent of vscode.d.ts). The package version IS the extension API version; extensions declare a compatible range via engines.universe.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovebirdsx/universe-editor.git",
    "directory": "packages/extension-api"
  },
  "homepage": "https://github.com/lovebirdsx/universe-editor#readme",
  "keywords": [
    "universe-editor",
    "extension",
    "api",
    "plugin"
  ],
  "files": [
    "dist",
    "!dist/__tests__",
    "COMPATIBILITY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsgo --build",
    "typecheck": "tsgo --build",
    "test": "vitest run",
    "lint": "eslint src --cache --cache-strategy content",
    "lint:fix": "eslint --fix src",
    "clean": "tsgo --build --clean"
  },
  "dependencies": {
    "vscode-languageserver-types": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@universe-editor/config-ts": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
