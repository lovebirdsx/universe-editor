{
  "name": "@universe-editor/extension-manifest",
  "version": "0.1.0",
  "description": "Universe Editor extension manifest protocol: typed manifest shapes, zod validation, activation event builders, engines.universe semver negotiation, category set.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovebirdsx/universe-editor.git",
    "directory": "packages/extension-manifest"
  },
  "homepage": "https://github.com/lovebirdsx/universe-editor#readme",
  "keywords": [
    "universe-editor",
    "extension",
    "manifest",
    "activation-events"
  ],
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest-schema": {
      "types": "./dist/manifest-schema.d.ts",
      "default": "./dist/manifest-schema.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsgo --build",
    "typecheck": "tsgo --build",
    "test": "vitest run",
    "lint": "eslint src --cache --cache-strategy content",
    "lint:fix": "eslint --fix src",
    "clean": "tsgo --build --clean"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@universe-editor/config-ts": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
