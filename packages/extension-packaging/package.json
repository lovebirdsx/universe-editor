{
  "name": "@universe-editor/extension-packaging",
  "version": "0.1.0",
  "description": "VSIX packaging for Universe Editor extensions: createVsix / readVsixManifest with manifest validation and zip-slip protection.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovebirdsx/universe-editor.git",
    "directory": "packages/extension-packaging"
  },
  "homepage": "https://github.com/lovebirdsx/universe-editor#readme",
  "keywords": [
    "universe-editor",
    "extension",
    "vsix",
    "packaging"
  ],
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsgo --build",
    "typecheck": "tsgo --build",
    "test": "vitest run",
    "lint": "eslint src --cache --cache-strategy content",
    "lint:fix": "eslint --fix src",
    "clean": "tsgo --build --clean"
  },
  "dependencies": {
    "@universe-editor/extension-manifest": "workspace:*",
    "adm-zip": "catalog:"
  },
  "devDependencies": {
    "@universe-editor/config-ts": "workspace:*",
    "@types/adm-zip": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
