{
  "name": "@universe-editor/node-services",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsgo --build",
    "typecheck": "tsgo --build",
    "lint": "eslint src --cache --cache-strategy content",
    "lint:fix": "eslint --fix src",
    "test": "vitest run",
    "dev": "tsgo --build --watch",
    "clean": "tsgo --build --clean"
  },
  "dependencies": {
    "@lydell/node-pty": "catalog:",
    "@parcel/watcher": "catalog:",
    "@universe-editor/extension-packaging": "workspace:*",
    "@universe-editor/extensions-common": "workspace:*",
    "@universe-editor/platform": "workspace:*",
    "@universe-editor/temp-root": "workspace:*",
    "@vscode/ripgrep": "catalog:",
    "smol-toml": "catalog:",
    "tar": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@universe-editor/config-ts": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
