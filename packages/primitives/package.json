{
  "name": "@universe-editor/primitives",
  "version": "0.1.0",
  "description": "Zero-dependency primitives shared by the editor kernel and the extension SDK: the URI codec/canonical shape and text-level path helpers. Internal package — no stability promise, breaking changes may land in any release.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovebirdsx/universe-editor.git",
    "directory": "packages/primitives"
  },
  "homepage": "https://github.com/lovebirdsx/universe-editor#readme",
  "keywords": [
    "universe-editor",
    "uri",
    "path",
    "primitives"
  ],
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsgo --build",
    "typecheck": "tsgo --build",
    "test": "vitest run",
    "lint": "eslint src --cache --cache-strategy content",
    "lint:fix": "eslint --fix src",
    "dev": "tsgo --build --watch",
    "clean": "tsgo --build --clean"
  },
  "devDependencies": {
    "@universe-editor/config-ts": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
