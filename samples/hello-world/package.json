{
  "name": "hello-world",
  "displayName": "Hello World",
  "description": "A minimal Universe Editor extension sample.",
  "version": "0.0.1",
  "publisher": "universe-samples",
  "license": "Apache-2.0",
  "type": "module",
  "icon": "icon.png",
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "engines": {
    "universe": ">=0.8.0 <1.0.0"
  },
  "files": ["dist", "icon.png"],
  "activationEvents": ["onCommand:hello-world.helloWorld"],
  "contributes": {
    "commands": [{ "command": "hello-world.helloWorld", "title": "Hello World: Hello World" }]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "uex package",
    "universe:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@universe-editor/extension-api": "^0.8.0",
    "@universe-editor/uex": "^0.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
