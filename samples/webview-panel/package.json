{
  "name": "webview-panel",
  "displayName": "Webview Panel",
  "description": "A minimal window.createWebviewPanel sample: an extension-owned webview tab not bound to any file.",
  "version": "0.0.1",
  "publisher": "universe-samples",
  "license": "Apache-2.0",
  "type": "module",
  "icon": "icon.png",
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "engines": {
    "universe": ">=0.12.0 <1.0.0"
  },
  "files": ["dist", "icon.png"],
  "activationEvents": [
    "onCommand:webview-panel.show",
    "onCommand:webview-panel.reveal",
    "onCommand:webview-panel.dispose"
  ],
  "contributes": {
    "commands": [
      { "command": "webview-panel.show", "title": "Webview Panel: Show Panel" },
      { "command": "webview-panel.reveal", "title": "Webview Panel: Reveal Panel" },
      { "command": "webview-panel.dispose", "title": "Webview Panel: Dispose Panel" }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "uex package",
    "universe:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@universe-editor/extension-api": "^0.12.0",
    "@universe-editor/uex": "^0.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
