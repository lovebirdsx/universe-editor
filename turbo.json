{
  "$schema": "https://v2-10-3.turborepo.dev/schema.json",
  "//": "typecheck dependsOn build + ^build (not ^typecheck): extensions typecheck with `tsgo --noEmit` and resolve upstream package types from dist/*.d.ts, which only `build` produces; ^build means a typecheck cache hit still restores upstream dist (build.outputs) to disk first — otherwise a clean CI checkout sees missing .d.ts and fails TS2307. The own-package `build` dep exists because library packages' typecheck script is `tsgo --build`, which EMITS into dist/ — without the edge, `turbo run typecheck` schedules e.g. workbench-ui#typecheck concurrently with workbench-ui#build (pulled in as a downstream ^build dep), two tsgo processes rewrite the same dist/, and turbo tars build.outputs while the other writer is mid-write: the cached artifact then contains truncated/empty .js files and every later run that restores it fails with undefined imports (CI-only, unreproducible locally). Ordering typecheck after build makes its tsgo a no-op. @universe-editor/editor#typecheck keeps plain ^build: all its tsconfigs are noEmit (no dist collision) and its build is the heavy electron-vite bundle that typecheck shouldn't drag in. --- e2e: every e2e task drives the PACKAGED editor (apps/editor/out) + reads built-in extensions from their repo `extensions/<ext>/dist`; an extension does NOT depend on @universe-editor/editor (dep runs the other way), so the global e2e task depends on `@universe-editor/editor#build` to keep the host fresh. The editor's own e2e suite activates git/typescript/markdown via its scoped core*App fixtures; those are declared devDependencies of @universe-editor/editor (so turbo affected re-runs core when they change — see scripts/e2e/affected-e2e-matrix.mjs), which also means the editor#e2e `^build` builds them automatically — no per-extension #build override needed. Net: `turbo run e2e --filter=<anything>` always builds a fresh host + the exact extensions the suite exercises.",
  "globalDependencies": [".prettierrc.json", ".prettierignore", "eslint.config.js"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "inputs": [
        "src/**",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "package.json",
        "tsconfig*.json",
        "electron.vite.config.ts",
        "build/**",
        "esbuild.config.mjs",
        "public/**"
      ],
      "outputs": ["dist/**", "out/**", "*.tsbuildinfo"]
    },
    "bundle": {
      "dependsOn": ["build", "^build"],
      "outputLogs": "new-only",
      "inputs": [
        "src/**",
        "!src/**/__tests__/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "package.json",
        "tsconfig*.json",
        "esbuild.config.mjs"
      ],
      "outputs": ["dist-bundle/**"]
    },
    "typecheck": {
      "dependsOn": ["build", "^build"],
      "outputLogs": "new-only",
      "outputs": []
    },
    // editor 的 lint/typecheck 默认 inputs 是整个包的 git 跟踪文件，改 CLAUDE.md/docs 也会
    // 整包重跑。收窄为命令实际读取的目录整列（宁可略宽不猜扩展名）。同步约束：给 lint/
    // typecheck 命令新增目录时必须同步这里的 inputs，否则改动不失效缓存=假绿。
    // !e2e/test-results、!e2e/playwright-report、!integration/node_modules：运行产物/缓存，
    // 显式 inputs glob 会匹配未跟踪文件，不排除则 hash 漂移、缓存永不命中（editor#test 同款教训）。
    "@universe-editor/editor#typecheck": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "inputs": [
        "src/**",
        "integration/**",
        "!integration/node_modules/**",
        "bench/**",
        "e2e/**",
        "!e2e/test-results/**",
        "!e2e/playwright-report/**",
        "tsconfig*.json",
        "package.json",
        "scripts/typecheck.mjs"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "outputs": []
    },
    // editor 的 test 拆成 4 个 turbo 任务并行调度：原 editor#test 单任务串行跑完 vitest
    // 3 project（main/renderer-node/renderer-dom）+ integration，CI 上 267s 卡瓶颈，其他
    // 32 个包都在 60s 内完成。现在每个 project 一个任务，inputs 收窄到该任务真正读的文件
    // ——改 renderer 不该让 main 的 cache 也失效，反之亦然。renderer-node 与 renderer-dom
    // 读同一批源文件（区别只在运行环境，不涉及不同文件集合）。integration 读
    // integration/** + src/main + src/renderer + src/shared：scenarios 与 fixtures 同时
    // import 三端源码（如 acpForkContract 引 services/acp/session/acpExtMethods，
    // explorerTree fixture 引 ExplorerTreeService），漏 src/renderer 会让改 renderer
    // 的 commit 命中陈旧 cache、集成测试假绿。src/preload/** 无需：没有任何测试在运行时
    // import preload，renderer 对它的 import type 会被擦除。
    // test-stubs/** 只列给 renderer-dom：monacoAlias（指向 test-stubs 的 resolve.alias）
    // 只挂在 vitest.config.ts 的 renderer-dom project；main / renderer-node / integration
    // 都不 import 这些 stub。vitest.renderer-setup.ts 同理只挂在 renderer-dom.setupFiles，
    // 不列给其他任务（且 vitest*.ts glob 已覆盖，显式列出只是为可读性）。
    // !integration/node_modules/**：vitest transform 缓存(results.json)每次运行都写，显式
    // inputs glob 会匹配未跟踪文件，不排除则 hash 永远漂移、缓存永不命中。
    // 并行资源：3 个 unit 子任务并发，vitest 默认 pool=forks、worker 按 CPU 核数分。若 CI
    // 实测反而变慢（低核 runner 过度订阅），下一步给 4 个子任务各加 --maxWorkers=<n>。
    "@universe-editor/editor#test:main": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "inputs": [
        "src/main/**",
        "src/shared/**",
        "vitest*.ts",
        "package.json",
        "tsconfig*.json"
      ],
      "outputs": []
    },
    "@universe-editor/editor#test:renderer-node": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "inputs": [
        "src/renderer/**",
        "src/shared/**",
        "vitest*.ts",
        "package.json",
        "tsconfig*.json"
      ],
      "outputs": []
    },
    "@universe-editor/editor#test:renderer-dom": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "inputs": [
        "src/renderer/**",
        "src/shared/**",
        "test-stubs/**",
        "vitest*.ts",
        "vitest.renderer-setup.ts",
        "package.json",
        "tsconfig*.json"
      ],
      "outputs": []
    },
    "@universe-editor/editor#test:integration": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "inputs": [
        "integration/**",
        "!integration/node_modules/**",
        "src/main/**",
        "src/renderer/**",
        "src/shared/**",
        "package.json",
        "tsconfig*.json"
      ],
      "outputs": []
    },
    "e2e": {
      "dependsOn": ["^build", "build", "@universe-editor/editor#build", "@universe-editor/remote-server#build"],
      "outputLogs": "new-only",
      "outputs": ["e2e/playwright-report/**", "e2e/test-results/**"],
      "env": [
        "CI",
        "UNIVERSE_E2E",
        "UNIVERSE_E2E_INCLUDE_REGRESSION",
        "UNIVERSE_E2E_ONLY_TAG",
        "UNIVERSE_E2E_ONLY_TAG_INVERT"
      ]
    },
    "e2ea": {
      "dependsOn": ["^build", "build", "@universe-editor/editor#build", "@universe-editor/remote-server#build"],
      "outputLogs": "new-only",
      "outputs": ["e2e/playwright-report/**", "e2e/test-results/**"],
      "env": [
        "CI",
        "UNIVERSE_E2E",
        "UNIVERSE_E2E_INCLUDE_REGRESSION",
        "UNIVERSE_E2E_ONLY_TAG",
        "UNIVERSE_E2E_ONLY_TAG_INVERT"
      ]
    },
    "lint": {
      "outputLogs": "new-only",
      "outputs": [".eslintcache"]
    },
    // 收窄理由与同步约束见 editor#typecheck 注释；lint 命令 = eslint src bench integration e2e
    "@universe-editor/editor#lint": {
      "outputLogs": "new-only",
      "inputs": [
        "src/**",
        "bench/**",
        "integration/**",
        "!integration/node_modules/**",
        "e2e/**",
        "!e2e/test-results/**",
        "!e2e/playwright-report/**",
        "eslint.config.js",
        "package.json",
        "tsconfig*.json"
      ],
      "outputs": [".eslintcache"]
    },
    "lint:fix": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
